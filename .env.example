# Copie para .env e ajuste (o .env não vai para o Git).

# Desenvolvimento: SQLite local. Produção (Vercel): URL do Neon, ex.
# postgresql://usuario:senha@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite:///./clgym.db

# Token que o app usa para acessar a API (mínimo 16 caracteres). Gere um com:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
APP_TOKEN=troque-por-um-token-gerado
