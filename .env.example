# Modelo do .env (que não vai para o Git). Num computador novo, `uv run scripts/preparar.py`
# cria o .env de desenvolvimento a partir deste arquivo; para produção, copie e ajuste.

# Desenvolvimento: SQLite local. Produção (Vercel): URL pooled do Neon, ex.
# postgresql://usuario:senha@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite:///./clgym.db

# ID do cliente OAuth "Aplicativo da Web" criado no Google Cloud (projeto sem faturamento).
GOOGLE_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxx.apps.googleusercontent.com

# Chave que assina os tokens de sessão (mínimo 32 caracteres). Trocar desloga todo mundo.
# Gere uma com:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SESSAO_SECRET=troque-por-uma-chave-gerada-com-pelo-menos-32-caracteres

# E-mail Google do administrador: entra sem convite, gera os convites dos amigos (aba Conta →
# Administração) e pode bloquear ou apagar contas. Os outros só criam conta com um convite
# (vale 24 h, para uma pessoa). No computador, é também o e-mail do "Entrar como dev".
ADMIN_EMAIL=voce@gmail.com

# Opcional: validade do token de sessão, em dias (padrão 90).
# SESSAO_DIAS=90

# Só no computador: mostra "Entrar como dev" na tela de login, sem Google. Só funciona com
# banco SQLite e fora da Vercel; em produção a rota responde 404 mesmo que isto esteja ligado.
# LOGIN_DEV=1
